(module
  ;; WASI preview 1 hello: writes "hello from wasm\n" to fd 1.
  ;; WAT text is accepted wherever .wasm modules are (wasmtime detects the
  ;; text format), keeping this example readable.
  (import "wasi_snapshot_preview1" "fd_write"
    (func $fd_write (param i32 i32 i32 i32) (result i32)))
  (memory (export "memory") 1)
  (data (i32.const 8) "hello from wasm\n")
  (func (export "_start")
    (i32.store (i32.const 0) (i32.const 8))   ;; iov base
    (i32.store (i32.const 4) (i32.const 16))  ;; iov length
    (drop (call $fd_write (i32.const 1) (i32.const 0) (i32.const 1) (i32.const 24))))
)
